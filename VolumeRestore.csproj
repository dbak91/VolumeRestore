<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0-android36.0</TargetFramework>
	<OutputType>Exe</OutputType>
	<RootNamespace>VolumeRestore</RootNamespace>
	<UseMaui>true</UseMaui>
	<SingleProject>true</SingleProject>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>

	<ApplicationTitle>Volume Restore</ApplicationTitle>
	<ApplicationId>com.example.volumerestore</ApplicationId>
	<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
	<ApplicationVersion>2</ApplicationVersion>

	<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>

  <ItemGroup>
	<None Include=".github\copilot-instructions.md" />
  </ItemGroup>

  <Import Project="release-signing\VolumeRestore.signing.props"
		  Condition="Exists('release-signing\VolumeRestore.signing.props')" />

</Project>
