<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VolumeRestore.MainPage"
             Title="Volume Restore"
             BackgroundColor="#121212">

    <ScrollView x:Name="SettingsScrollView">
        <VerticalStackLayout x:Name="SettingsLayout" Padding="20" Spacing="14">
            <Label Text="Volume Restore Settings"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#F2F2F2" />

            <Label Text="Monitoring starts automatically. Hitting either pause level restarts the pause timer; trigger hits during the pause are ignored. Settings are saved only on this device."
                   FontSize="13"
                   TextColor="#CFCFCF" />

            <Border BackgroundColor="#1E1E1E" Stroke="#455A64" StrokeThickness="1" Padding="16">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                    <Label Text="Event Monitoring"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#F2F2F2"
                           VerticalOptions="Center" />
                    <Switch x:Name="MonitoringSwitch"
                            Grid.Column="1"
                            Toggled="OnMonitoringToggled"
                            OnColor="#2E7D32"
                            VerticalOptions="Center" />
                    <Label x:Name="MonitoringStatusLabel"
                           Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="0,8,0,0"
                           FontSize="13"
                           FontAttributes="Bold" />
                </Grid>
            </Border>

            <Border BackgroundColor="#1E1E1E" Stroke="#3D8BFD" StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Level to restore to" TextColor="#F2F2F2" FontAttributes="Bold" />
                    <Entry x:Name="RestoreLevelEntry" Keyboard="Numeric" Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" TextColor="#FFFFFF" BackgroundColor="#2C2C2C" />

                    <Label Text="Restore Trigger" TextColor="#F2F2F2" FontAttributes="Bold" />
                    <Entry x:Name="RestoreTriggerEntry" Keyboard="Numeric" Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" TextColor="#FFFFFF" BackgroundColor="#2C2C2C" />

                    <Label Text="Lower Pause Level" TextColor="#F2F2F2" FontAttributes="Bold" />
                    <Entry x:Name="MinPauseLevelEntry" Keyboard="Numeric" Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" TextColor="#FFFFFF" BackgroundColor="#2C2C2C" />

                    <Label Text="Higher Pause Level" TextColor="#F2F2F2" FontAttributes="Bold" />
                    <Entry x:Name="MaxPauseLevelEntry" Keyboard="Numeric" Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" TextColor="#FFFFFF" BackgroundColor="#2C2C2C" />

                    <Label Text="Pause Duration (minutes)" TextColor="#F2F2F2" FontAttributes="Bold" />
                    <Entry x:Name="PauseDurationEntry" Keyboard="Numeric" Focused="OnEntryFocused" Unfocused="OnEntryUnfocused" TextColor="#FFFFFF" BackgroundColor="#2C2C2C" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Save Settings"
                        Clicked="OnSaveSettingsClicked"
                        BackgroundColor="#2E7D32"
                        TextColor="White" />
                <Button Grid.Column="1"
                        Text="Reset Defaults"
                        Clicked="OnResetDefaultsClicked"
                        BackgroundColor="#455A64"
                        TextColor="White" />
            </Grid>

            <Label x:Name="StatusLabel"
                   Text=""
                   FontSize="13"
                   TextColor="#A5D6A7" />

            <BoxView x:Name="KeyboardSpacer"
                     HeightRequest="0"
                     Opacity="0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
